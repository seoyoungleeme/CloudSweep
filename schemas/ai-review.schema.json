{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudSweep AI Review",
  "type": "object",
  "required": ["schema_version", "run_id", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "review_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "quality_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missed_candidate_hypotheses": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

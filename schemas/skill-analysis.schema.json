{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudSweep Complex Skill Analysis Output",
  "description": "Authoritative findings written by a Claude complex-domain Skill from a LangGraph structured evidence bundle.",
  "type": "object",
  "required": ["schema_version", "domain", "findings"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "domain": {
      "type": "string",
      "enum": ["rds", "elb", "ecs", "elasticache"]
    },
    "skill_version": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "resource",
          "severity",
          "confidence",
          "estimated_monthly_saving_usd",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "INFO"] },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
          "estimated_monthly_saving_usd": { "type": "number", "minimum": 0 },
          "pricing_source": {
            "type": "string",
            "enum": ["cost_report", "aws_public_pricing_model", "static_fallback_estimate", "reasonable_estimate", "unmeasured"]
          },
          "pricing_confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "savings_status": {
            "type": "string",
            "enum": ["priced", "reasonable_estimate", "unmeasured"]
          },
          "savings_reason": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "recommendation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

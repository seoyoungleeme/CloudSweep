{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudSweep Pricing Model",
  "description": "Raw AWS public on-demand unit prices supplied by Claude via mcp__aws-pricing__get_pricing for a domain whose cost_report evidence is absent or not resource-specific. Carries a unit price only -- never a savings figure or a finding.",
  "type": "object",
  "required": ["schema_version", "domain", "pricing_source", "unit_prices"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "domain": { "type": "string", "enum": ["s3", "lambda", "rds", "elb", "ecs", "elasticache"] },
    "pricing_source": { "type": "string", "const": "aws_public_pricing_model" },
    "generated_at": { "type": "string" },
    "unit_prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku_key", "unit", "price_usd"],
        "properties": {
          "sku_key": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "price_usd": { "type": "number", "minimum": 0 },
          "aws_pricing_sku": { "type": "string" },
          "source_tool": { "type": "string", "const": "mcp__aws-pricing__get_pricing" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
